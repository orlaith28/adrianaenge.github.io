<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Adriana Enge — Product Leader</title>
<meta name="description" content="Product portfolio of Adriana Enge — data-driven product leader, case studies in AI-augmented delivery and logistics optimization.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --paper:#EEF0F2;
    --paper-deep:#E3E7EA;
    --ink:#10161B;
    --teal:#146B70;
    --teal-deep:#0E4F53;
    --amber:#C98B2E;
    --muted:#55636B;
    --line:#C7CED2;
    --max:760px;
  }

  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}

  body{
    margin:0;
    background:var(--paper);
    color:var(--ink);
    font-family:'IBM Plex Sans', sans-serif;
    font-size:17px;
    line-height:1.65;
    -webkit-font-smoothing:antialiased;
  }

  h1,h2,h3{
    font-family:'Fraunces', serif;
    font-weight:600;
    letter-spacing:-0.01em;
    margin:0;
  }

  a{color:var(--teal-deep);}
  a:hover{color:var(--amber);}
  a:focus-visible, button:focus-visible{outline:2px solid var(--teal); outline-offset:3px;}

  .wrap{
    max-width: 1180px;
    margin:0 auto;
    display:grid;
    grid-template-columns: 220px 1fr;
    gap:0 48px;
    padding: 0 32px;
  }

  /* ---------- index rail ---------- */
  nav.index{
    position:sticky;
    top:56px;
    align-self:start;
    padding-top:96px;
    font-size:14px;
  }
  nav.index .label{
    font-size:12px;
    color:var(--muted);
    margin-bottom:14px;
    letter-spacing:0.02em;
  }
  nav.index ol{
    list-style:none;
    margin:0; padding:0;
    border-left:1px solid var(--line);
  }
  nav.index li{margin:0;}
  nav.index a{
    display:block;
    padding:9px 0 9px 16px;
    color:var(--muted);
    text-decoration:none;
    border-left:2px solid transparent;
    margin-left:-1px;
    transition:color .15s ease, border-color .15s ease;
  }
  nav.index a:hover{color:var(--ink);}
  nav.index a.active{
    color:var(--teal-deep);
    border-left-color:var(--teal);
    font-weight:500;
  }

  main{min-width:0; padding-bottom:80px;}

  section{
    max-width:var(--max);
    padding-top:96px;
  }
  section:first-of-type{padding-top:64px;}

  /* ---------- hero ---------- */
  .hero h1{font-size:52px; line-height:1.05;}
  .hero .role{
    font-family:'IBM Plex Sans', sans-serif;
    font-size:18px;
    color:var(--muted);
    margin-top:10px;
  }
  .hero .dek{
    margin-top:22px;
    font-size:18px;
    max-width:640px;
  }
  .hero .meta{
    margin-top:22px;
    font-size:14px;
    color:var(--muted);
  }
  .hero .meta a{margin-right:18px;}

  .readout{
    margin-top:44px;
    display:grid;
    grid-template-columns:repeat(3,1fr);
    border-top:1px solid var(--line);
    border-bottom:1px solid var(--line);
  }
  .readout div{
    padding:18px 18px 18px 0;
    border-right:1px solid var(--line);
  }
  .readout div:last-child{border-right:none;}
  .readout .num{
    font-family:'Fraunces', serif;
    font-size:28px;
    color:var(--teal-deep);
  }
  .readout .cap{
    font-size:13px;
    color:var(--muted);
    margin-top:4px;
  }

  /* ---------- about ---------- */
  .kicker{
    font-size:13px;
    color:var(--teal-deep);
    margin-bottom:10px;
  }
  section h2{font-size:30px;}
  .about p{margin-top:16px; max-width:640px;}
  .skills{
    margin-top:26px;
    display:flex;
    flex-wrap:wrap;
    gap:9px;
  }
  .skills span{
    font-size:13px;
    padding:6px 12px;
    border:1px solid var(--line);
    border-radius:3px;
    color:var(--muted);
    background:var(--paper-deep);
  }

  /* ---------- case studies ---------- */
  .case-head{
    display:flex;
    align-items:baseline;
    gap:14px;
  }
  .case-head .idx{
    font-family:'Fraunces', serif;
    font-size:16px;
    color:var(--amber);
  }
  .case-sub{
    color:var(--muted);
    font-size:15px;
    margin-top:8px;
  }

  .metrics-strip{
    margin:32px 0;
    display:flex;
    flex-wrap:wrap;
    gap:0;
    background:var(--ink);
    color:var(--paper);
    border-radius:2px;
  }
  .metrics-strip div{
    flex:1 1 140px;
    padding:18px 20px;
    border-right:1px solid rgba(255,255,255,0.14);
  }
  .metrics-strip div:last-child{border-right:none;}
  .metrics-strip .num{
    font-family:'Fraunces', serif;
    font-size:22px;
    color:#fff;
  }
  .metrics-strip .cap{
    font-size:12.5px;
    color:#B9C4C6;
    margin-top:3px;
  }

  .field{margin-top:34px;}
  .field h3{
    font-size:14px;
    font-family:'IBM Plex Sans', sans-serif;
    font-weight:600;
    color:var(--teal-deep);
    text-transform:none;
    border-bottom:1px solid var(--line);
    padding-bottom:8px;
    margin-bottom:14px;
  }
  .field p{margin:0 0 12px;}
  .field ul{margin:0; padding-left:20px;}
  .field li{margin-bottom:8px;}

  .shot{
    margin:22px 0;
    border:1.5px dashed var(--line);
    border-radius:4px;
    padding:34px 20px;
    text-align:center;
    color:var(--muted);
    font-size:13.5px;
    background:rgba(255,255,255,0.35);
  }
  .shot strong{display:block; color:var(--ink); font-size:14px; margin-bottom:4px; font-weight:600;}

  /* ---------- experience ---------- */
  .xp-item{
    padding:18px 0;
    border-top:1px solid var(--line);
    display:grid;
    grid-template-columns: 150px 1fr;
    gap:18px;
  }
  .xp-item:last-child{border-bottom:1px solid var(--line);}
  .xp-dates{font-size:13px; color:var(--muted); padding-top:2px;}
  .xp-role{font-weight:600;}
  .xp-co{color:var(--muted); font-size:15px;}

  /* ---------- contact ---------- */
  .contact-box{
    margin-top:20px;
    padding:28px;
    background:var(--paper-deep);
    border-radius:4px;
  }
  .contact-box a{
    display:inline-block;
    margin-top:10px;
    font-size:15px;
  }

  footer{
    max-width:var(--max);
    padding:40px 0 60px;
    font-size:13px;
    color:var(--muted);
  }

  @media (max-width: 880px){
    .wrap{grid-template-columns:1fr; padding:0 20px;}
    nav.index{
      position:static;
      padding-top:24px;
      margin-bottom:8px;
    }
    nav.index ol{
      border-left:none;
      display:flex;
      flex-wrap:wrap;
      gap:4px 16px;
      border-bottom:1px solid var(--line);
      padding-bottom:12px;
    }
    nav.index a{padding:4px 0; border-left:none;}
    nav.index a.active{border-left:none; text-decoration:underline;}
    .hero h1{font-size:38px;}
    .readout{grid-template-columns:1fr 1fr;}
    .readout div:nth-child(2n){border-right:none;}
    section{padding-top:64px;}
    .xp-item{grid-template-columns:1fr;}
  }
</style>
</head>
